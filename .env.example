# ─── Base de Datos ───────────────────────────────────────────────────
# PostgreSQL (Supabase) para producción
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# SQLite para desarrollo local (se usa automáticamente si no se define DATABASE_URL)
# DATABASE_URL=sqlite:///path/to/chambachat.db

# ─── DeepSeek LLM ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ─── JWT Authentication ─────────────────────────────────────────────
# OBLIGATORIO en producción. Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=1440

# ─── CORS ────────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por comas
CORS_ORIGINS=https://chambachat.onrender.com,https://chambachat.com,http://localhost:5173

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Chambachat <onboarding@resend.dev>

# ─── Email (SMTP alternativo) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Correo transaccional ───
# URL publica del frontend, usada para logos e imagenes en los correos
PUBLIC_BASE_URL=https://chambachat.onrender.com
